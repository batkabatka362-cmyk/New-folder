# Copy to .env and fill in. NEVER commit .env (it will hold secrets / keys).
#
# This file lists the COMMON knobs. EVERY tunable lives in memebot/config.py as a
# frozen Settings dataclass with a safe default — you only need to set what you want
# to OVERRIDE. The full list (safety gates, momentum thresholds, exit ladder, risk
# limits, fees, all loop intervals) is in config.py's load(); set any of them here in
# the same NAME=value form and it takes effect. Out of the box you can leave .env
# almost empty (just add HELIUS_RPC_URL for the concentration rug-tell).

# ── Mode ─────────────────────────────────────────────────────
MODE=paper                          # paper | live   (live = Phase 5 only)
LOG_LEVEL=INFO

# ── Data feeds (Phase 1) ─────────────────────────────────────
# PumpPortal: free WebSocket for discovery (subscribeNewToken / subscribeMigration).
# An API KEY is ONLY needed for the metered per-token TRADE stream (G3) — that is the
# only way to see real-time curve-phase trades and catch a launch as it happens.
#   COST: 0.01 SOL per 10,000 websocket events; the api-key wallet must hold >=0.02 SOL.
#   To enable G3 (real SOL spend, DATA only — trades still PAPER):
#     1) PUMPPORTAL_API_KEY=<key from a funded wallet>
#     2) TRADE_STREAM_ENABLED=true   (watchlist is bounded to WATCHLIST_SIZE to cap cost)
#   Leave both unset to stay 100% free (discovery only; trades the DexScreener-indexed set).
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data
PUMPPORTAL_API_KEY=
# TRADE_STREAM_ENABLED=false

# Helius free RPC key -> get one at https://helius.dev  (authority / LP burn / holders)
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY_HERE
# Public fallback RPC (heavily rate limited)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# DexScreener needs no key
DEXSCREENER_BASE_URL=https://api.dexscreener.com

# Optional deep data (Phase 4)
BITQUERY_API_KEY=
MORALIS_API_KEY=

# ── Brain: LLM backend (Phase 3) ─────────────────────────────
# auto = try local Ollama first, then cloud Claude, else rule-based fallback
LLM_BACKEND=auto                    # auto | local | cloud | off
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:4b              # FAST screener model (every decision)
OLLAMA_CONFIRM_MODEL=qwen3:8b      # deeper local model; confirms low-conviction buys only ("" = single-model, no escalation)
LLM_PARALLEL=3                      # concurrent brain decisions / eval cycle (1 = serial; set to your Ollama OLLAMA_NUM_PARALLEL)
LLM_PER_MIN=5                       # max LLM decision calls / minute
HIGH_CONF_THRESHOLD=0.8             # >= this score acts locally (no LLM)
ANTHROPIC_API_KEY=                  # only for LLM_BACKEND=cloud (or auto without Ollama)

# ── P8: miss-learning (regret) — learn from skipped tokens that later pumped ──
MISS_LEARN_ENABLED=true             # replay observed-but-not-bought mints; learn the ones that ran
MISS_LEARN_INTERVAL_S=600           # how often to replay (off the hot path); 0 disables
MISS_WIN_THRESHOLD_PCT=50           # forward return >= this since we saw it = a "missed winner"

# ── P8: self-calibration — classify our own outcomes, learn what separates winners from rugs (advisory) ──
CALIBRATE_ENABLED=true              # periodically classify observations + learn creator reputation
CALIBRATE_INTERVAL_S=3600           # how often (1h, off the hot path); 0 disables. Suggestions are LOGGED, never auto-applied.
CALIBRATE_MIN_MINTS=40              # don't calibrate on fewer classified mints than this

# ── Phase 2: GBM scorer (rule scorer is used until a model is trained) ──
GBM_MODEL_PATH=gbm_model.txt

# ── Alerts (optional) ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Paper portfolio ──────────────────────────────────────────
# (defaults below mirror config.py — the defensive survival-first profile)
INITIAL_SOL=10.0
MAX_POSITIONS=5                      # concurrent HOLDs
MAX_POSITION_SOL=1.0                 # absolute per-trade ceiling (caps compounding)
DAILY_LOSS_CAP_SOL=1.5               # circuit breaker (~15% of equity)
RISK_PER_TRADE_FRAC=0.04             # equity fraction per trade -> position grows as equity grows
MAX_TOTAL_EXPOSURE_FRAC=0.20         # whole-book exposure ceiling (the true concurrency governor)
MAX_LIQUIDITY_FRAC=0.02             # cap a buy at this fraction of pool liquidity (slippage control)
# SCALP buy lane is OFF by default (structurally negative on free data). TRADE_SCALP=true to re-enable.

# ── Fees / slippage (model pump.fun reality, not stock defaults) ──
PUMPPORTAL_FEE_PCT=0.005            # PumpPortal Local Tx API = 0.5%
PUMPFUN_CURVE_FEE_PCT=0.0125        # pump.fun on-curve = 1.25%
PRIORITY_FEE_SOL=0.0005             # est. Solana priority fee per tx
MIGRATION_FEE_SOL=0.015             # one-time at graduation
BASE_SLIPPAGE_PCT=0.03              # thin bonding-curve liquidity -> default 3%

# ── Storage ──────────────────────────────────────────────────
DB_PATH=memebot.db
